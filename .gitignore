# Vercel builds from source. It needs package.json, package-lock.json, src/,
# index.html, tsconfig.json, vite.config.ts and vercel.json. Nothing below is
# needed by the build, so none of it belongs on GitHub.

node_modules/
dist/
.vite/
.vercel/

# --- secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
.npmrc
.netrc
*.token
secrets.json
credentials.json

# --- the homepage lives here but belongs to its own repo ---
# urbgen.com is a separate project with a separate Vercel deployment. It sits
# in this folder for convenience only; committing it here would put two repos
# on top of each other.
homepage/

# --- noise ---
*.log
*.local
.DS_Store
Thumbs.db
